# Sao chép thành .env rồi điền mật khẩu mạnh, hoặc chạy ./scripts/gen-env.sh để tự sinh.
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_NAME=quizdb
DB_USER=quizapp
DB_PASSWORD=CHANGE_ME
EXPORTER_DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Cổng publish. Mặc định các công cụ quản trị chỉ mở ở 127.0.0.1.
# Đặt BIND_ADDR=0.0.0.0 nếu cần demo từ máy khác (không khuyến nghị khi vận hành thật).
BIND_ADDR=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
PMA_PORT=8081
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
