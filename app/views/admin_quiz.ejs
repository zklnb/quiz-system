<%- include('partials/header') %>
<h1><%= quiz.title %></h1>
<p><a href="/admin">&larr; Quay lại</a></p>
<form method="post" action="/admin/quiz/<%= quiz.id %>/question" class="form">
  <h3>Thêm câu hỏi</h3>
  <label>Nội dung <textarea name="content" required maxlength="1000"></textarea></label>
  <label>Đáp án A <input name="option_a" required maxlength="500"></label>
  <label>Đáp án B <input name="option_b" required maxlength="500"></label>
  <label>Đáp án C <input name="option_c" required maxlength="500"></label>
  <label>Đáp án D <input name="option_d" required maxlength="500"></label>
  <label>Đáp án đúng
    <select name="correct_option"><option>A</option><option>B</option><option>C</option><option>D</option></select>
  </label>
  <button class="btn" type="submit">Thêm câu hỏi</button>
</form>
<h2>Danh sách câu hỏi (<%= questions.length %>)</h2>
<% questions.forEach((qs, i) => { %>
  <div class="card">
    <p><strong>Câu <%= i + 1 %>.</strong> <%= qs.content %></p>
    <div class="opt <%= qs.correct_option === 'A' ? 'is-correct' : '' %>">A. <%= qs.option_a %></div>
    <div class="opt <%= qs.correct_option === 'B' ? 'is-correct' : '' %>">B. <%= qs.option_b %></div>
    <div class="opt <%= qs.correct_option === 'C' ? 'is-correct' : '' %>">C. <%= qs.option_c %></div>
    <div class="opt <%= qs.correct_option === 'D' ? 'is-correct' : '' %>">D. <%= qs.option_d %></div>
    <form method="post" action="/admin/question/<%= qs.id %>/delete" class="inline"><button class="link danger" data-confirm="Xoá câu hỏi này?" type="submit">Xoá câu hỏi</button></form>
  </div>
<% }) %>
<%- include('partials/footer') %>
