<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - QuizSystem</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">Q</span> QuizSystem</a>
  <nav>
    <a href="/">Bài thi</a>
    <% if (user) { %>
      <a href="/history">Lịch sử</a>
      <% if (user.role === 'admin') { %><a href="/admin">Quản trị</a><% } %>
      <form method="post" action="/logout" class="inline"><button class="link" type="submit">Đăng xuất (<%= user.username %>)</button></form>
    <% } else { %>
      <a href="/login">Đăng nhập</a>
      <a href="/register">Đăng ký</a>
    <% } %>
  </nav>
</header>
<main class="container">
